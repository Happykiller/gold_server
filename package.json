{
  "name": "gold_server",
  "version": "1.2.5",
  "description": "gold_server",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "env NODE_ENV=prod nest start",
    "start:watch": "env NODE_ENV=prod nest start --watch",
    "start:dev": "env NODE_ENV=dev nest start --watch",
    "start:mock": "env NODE_ENV=mock nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "env NODE_ENV=test jest --coverage --no-cache",
    "test:watch": "env NODE_ENV=test jest --watch --coverage --no-cache",
    "test:e2e": "env NODE_ENV=test jest --config ./jest-e2e.json",
    "eros": "eros_gql",
    "link:sunny": "npm link @happykiller/sunny-apis",
    "up:sunny": "npm install @happykiller/sunny-apis@latest --force"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@happykiller/sunny-apis": "^0.9.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@passwordless-id/webauthn": "^2.3.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "eros_gql": "^1.2.8",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "mysql2": "^3.14.1",
    "passport-jwt": "^4.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.3",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^17.9.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  }
}
