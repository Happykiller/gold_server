{
  "name": "gold_server",
  "version": "0.10.0",
  "description": "gold_server",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "env NODE_ENV=prod nest start",
    "start:watch": "env NODE_ENV=prod nest start --watch",
    "start:dev": "env NODE_ENV=dev nest start --watch",
    "start:mock": "env NODE_ENV=mock nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "env NODE_ENV=test jest --coverage --no-cache",
    "test:watch": "env NODE_ENV=test jest --watch --coverage --no-cache",
    "test:e2e": "env NODE_ENV=test jest --config ./jest-e2e.json",
    "eros": "eros_gql"
  },
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "@nestjs/apollo": "^11.0.5",
    "@nestjs/common": "^9.4.0",
    "@nestjs/core": "^9.4.0",
    "@nestjs/graphql": "^11.0.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.2.1",
    "@nestjs/throttler": "^3.1.0",
    "@passwordless-id/webauthn": "^2.3.0",
    "@types/passport-jwt": "^4.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "eros_gql": "^1.2.8",
    "graphql": "^16.11.0",
    "mysql2": "^3.14.1",
    "passport-jwt": "^4.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.17",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
